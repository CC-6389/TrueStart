{
  "name": "myvue-cinema-helper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser extension that shows true film start times on MyVue cinema 'what's on' pages.",
  "scripts": {
    "build": "tsc && esbuild src/content.ts --bundle --format=iife --outfile=dist/content.js",
    "watch": "tsc --watch",
    "test": "npm run build && node --test dist"
  },
  "keywords": [
    "typescript",
    "firefox",
    "extension",
    "myvue",
    "cinema",
    "chrome"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chrome": "^0.0.271",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
